{
  "name": "koty-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=8.15.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present run typecheck",
    "test": "vitest run",
    "test:shell": "node scripts/tests/run-bootstrap-tests.mjs",
    "test:integration": "pnpm db:start && pnpm --filter @koty-app/api test:integration && pnpm db:stop",
    "crew:check": "uv run --project crewai pytest crewai/tests -v && OPENSPEC_TELEMETRY=0 pnpm exec openspec validate --all --strict",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:shell && pnpm build && pnpm crew:check",
    "clean": "pnpm -r --filter=./** clean",
    "start:web": "pnpm --filter @koty-app/web start",
    "start:api": "pnpm --filter @koty-app/api start",
    "start:worker": "pnpm --filter @koty-app/worker start",
    "db:start": "docker compose up -d --wait --wait-timeout 60",
    "db:stop": "docker compose down",
    "db:status": "docker compose ps",
    "db:migrate:dev": "pnpm --filter @koty-app/api db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @koty-app/api db:migrate:deploy",
    "db:migrate:reset": "pnpm --filter @koty-app/api db:migrate:reset",
    "db:migrate:status": "pnpm --filter @koty-app/api db:migrate:status",
    "db:verify": "pnpm --filter @koty-app/api db:verify"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.4.1",
    "eslint": "9.39.5",
    "vitest": "3.2.6"
  }
}