# ==========================================
# Linear
# ==========================================

LINEAR_API_KEY=

LINEAR_TEAM_KEY=DEV
LINEAR_PROJECT_NAME=koty-app

LINEAR_QUEUE_ASSIGNEE_EMAIL=
LINEAR_QUEUE_MILESTONE=

LINEAR_IN_PROGRESS_STATE=In Progress
LINEAR_DONE_STATE=Done

MAX_TICKET_ATTEMPTS=4
MAX_INFRASTRUCTURE_ATTEMPTS=2


# ==========================================
# CrewAI / OpenCode Go
# ==========================================

OPENCODE_API_KEY=

ZEN_BASE_URL=https://opencode.ai/zen/go/v1

ZEN_ANALYST_MODEL=
ZEN_ARCHITECT_MODEL=
ZEN_CODER_MODEL=
ZEN_TESTER_MODEL=
ZEN_REVIEWER_MODEL=

# Per-role output limits and staged Architect bounds. Each LLM role invocation
# persists its configured limit and CrewAI usage under the active OpenSpec attempt.
ZEN_ANALYST_MAX_TOKENS=2000
ZEN_ARCHITECT_OUTLINE_MAX_TOKENS=4000
ZEN_ARCHITECT_ARTIFACT_MAX_TOKENS=8000
ZEN_ARCHITECT_RETRY_MAX_TOKENS=16000
ZEN_ARCHITECT_LENGTH_RETRIES=1
ZEN_ARCHITECT_MAX_CONTEXT_REFS=12
ZEN_ARCHITECT_MAX_CONTEXT_CHARS=48000
ZEN_CODER_MAX_TOKENS=2500
ZEN_TESTER_MAX_TOKENS=600
ZEN_REVIEWER_MAX_TOKENS=800


# ==========================================
# Local development
# ==========================================

LOCAL_APP_URL=http://127.0.0.1:3000
LOCAL_DEV_COMMAND=pnpm dev

PLAYWRIGHT_CLI_SESSION=crewai


# ==========================================
# CrewAI
# ==========================================

CREWAI_VERBOSE=false
CREWAI_TRACING_ENABLED=false
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
