# API
PORT=3001
NODE_ENV=development
# Database connection string (local development)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/plandepo_dev

# Empty database used only by `pnpm db:verify` to reconstruct migration history.
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/plandepo_shadow

# Integration test database. Used as the template URL for the isolated database
# that global-setup provisions per run. The actual database name will be
# `plandepo_test_<runId>`.
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/plandepo_test

# Web
# API URL accessible from browser (public variable - no credentials)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CORS
CORS_ORIGINS=http://localhost:3000

# Worker
WORKER_CONCURRENCY=2
